#!/bin/zsh
set -euo pipefail

readonly service="com.binion.monday.openai"
readonly account="${USER:-monday-local}"

if security find-generic-password -a "$account" -s "$service" >/dev/null 2>&1; then
  echo "MONDAY OpenAI API key: configured in macOS Keychain"
  exit 0
fi

echo "MONDAY OpenAI API key: not configured"
exit 1
