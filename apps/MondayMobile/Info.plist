<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MONDAY</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>36</string>
	<key>CodexActivityBridgeToken</key>
	<string>$(CODEX_ACTIVITY_BRIDGE_TOKEN)</string>
	<key>CodexActivityBridgeURL</key>
	<string>$(CODEX_ACTIVITY_BRIDGE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MONDAY reads your schedule and, only after explicit approval, creates calendar events for you.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MONDAY creates calendar events only after showing you a preview and receiving explicit approval.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MONDAY uses your local network only to show the read-only Codex activity feed from your own Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MONDAY uses the microphone only for foreground voice conversation that you start.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>MONDAY reads reminders and creates a reminder only after showing you a preview and receiving explicit approval.</string>
	<key>NSSiriUsageDescription</key>
	<string>MONDAY provides explicit Siri shortcuts for opening your conversation and hearing what is waiting.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MONDAY transcribes speech only while you are actively speaking to it.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.chris.monday.knowledge</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Monday Knowledge</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
