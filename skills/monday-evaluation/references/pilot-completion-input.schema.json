{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.monday/pilot-completion-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pilotID",
    "disposition",
    "approvedBy",
    "approvedAt",
    "finalObservationDigest",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "pilotID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "disposition": {"enum": ["accept", "extend", "stop"]},
    "approvedBy": {"const": "Chris"},
    "approvedAt": {"type": "string", "format": "date-time"},
    "finalObservationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"}
  }
}
