{
  "schemaVersion": 2,
  "runtimeDatabaseVersion": 2,
  "operationsProjectionVersion": 2,
  "operationsReadbackVersion": 1,
  "capabilityVersion": "2.0.0",
  "supportedPluginVersions": {
    "minimumInclusive": "0.1.0",
    "maximumExclusive": "0.2.0"
  },
  "supportedAppVersions": {
    "minimumInclusive": "0.4.1",
    "maximumExclusive": "0.5.0"
  },
  "retryPolicy": {
    "classifications": ["transient", "permanent", "uncertain"],
    "workflowMaximumAttempts": 10,
    "externalAutomaticRetry": false
  },
  "alertPolicy": {
    "staleExternalActionMinutes": 15,
    "failureWindowMinutes": 60,
    "failureCountThreshold": 3,
    "morningPipelineDeadline": "06:16-local",
    "knownRunningAppReadbackMinutes": 5,
    "blockedMinutes": 30,
    "stalledLeaseMinutes": 15,
    "deduplication": "code-plus-entity",
    "cooldownMinutes": 15,
    "resolution": "verified-authoritative-state-no-longer-meets-trigger",
    "lifecycle": ["open", "acknowledged", "resolved"],
    "signalProvenance": ["runtime-derived", "external-monitor"]
  },
  "pairings": [
    {
      "plugin": ">=0.1.0 <0.2.0",
      "capability": "2.0.0",
      "runtimeDatabase": 2,
      "operationsProjection": 2,
      "operationsReadback": 1,
      "app": ">=0.4.1 <0.5.0"
    }
  ],
  "versionPolicy": {
    "upgrade": "registered-migration-with-verified-backup",
    "downgrade": "automatic-downgrade-forbidden",
    "rollback": "restore-verified-pre-migration-backup-only"
  },
  "projectionMigrations": [
    {
      "id": "operations-projection-1-to-2",
      "from": 1,
      "to": 2,
      "lossless": true,
      "requiresReview": false,
      "preMigrationBackup": true,
      "digestVerification": true,
      "atomicRollback": true,
      "testedRestore": true
    }
  ]
}
