{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monday://schemas/professional-twin/v1",
  "title": "MONDAY Professional Twin Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordID", "domain", "recordType", "statement", "purpose", "evidenceClass", "confidence", "sensitivity", "status", "version", "createdAt", "updatedAt", "reviewAt", "learningAllowed", "consentBasis", "sourceRefs", "projection"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "domain": {"const": "professional"},
    "recordType": {"enum": ["working-preference", "capability", "responsibility", "relationship-context", "recurring-pattern", "constraint", "development-goal"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidenceClass": {"enum": ["observed", "reported", "inferred", "supported", "validated", "proposed", "decided", "unknown", "blocked", "unresolved"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity": {"enum": ["private", "internal", "shareable", "restricted"]},
    "status": {"enum": ["active", "superseded", "expired"]},
    "version": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "reviewAt": {"type": "string", "format": "date-time"},
    "learningAllowed": {"const": true},
    "consentBasis": {"enum": ["explicit", "user-supplied", "governed-record"]},
    "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/sourceRef"}},
    "contradictions": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}},
    "supersedes": {"type": ["string", "null"]},
    "projection": {"$ref": "#/$defs/projection"}
  },
  "$defs": {
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["sourceID", "evidenceID", "sourceDate", "capturedAt"], "properties": {"sourceID": {"type": "string"}, "evidenceID": {"type": "string", "pattern": "^[a-zA-Z0-9._:-]{3,160}$"}, "sourceDate": {"type": "string", "format": "date-time"}, "capturedAt": {"type": "string", "format": "date-time"}, "locator": {"type": "string", "maxLength": 300}}},
    "projection": {"type": "object", "additionalProperties": false, "required": ["includeInCommandCenter", "includeStatement"], "properties": {"includeInCommandCenter": {"type": "boolean"}, "includeStatement": {"type": "boolean"}}}
  }
}
